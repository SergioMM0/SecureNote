								"exec": [
									"// Test: For 200 OK, ensure the response body contains valid NoteDto data",
									"pm.test(\"Valid NoteDto response for 200 OK\", function () {",
									"    if (pm.response.status === 200) {",
									"        let responseJson = pm.response.json();",
									"        pm.expect(responseJson).to.have.property(\"id\");",
									"        pm.expect(responseJson).to.have.property(\"content\"); // Assuming content exists in NoteDto",
									"        pm.expect(responseJson).to.have.property(\"userId\");",
									"        //pm.expect(responseJson.userId).to.eql(pm.environment.get(\"user_id\")); // Check if the response userId matches the authenticated user",
									"    }",
									"});",
									"",
									"// Test: For 401 Unauthorized, verify the response is as expected",
									"pm.test(\"Unauthorized response if no user is authenticated\", function () {",
									"    if (pm.response.status === 401) {",
									"        let responseJson = pm.response.json();",
									"        pm.expect(responseJson).to.have.property(\"message\").that.is.a(\"string\");",
									"    }",
									"});",
									"",
									"// Test: For 404 Not Found, ensure the note does not exist or the user is unauthorized to access it",
									"pm.test(\"404 Not Found if the note is not found or user does not have access\", function () {",
									"    if (pm.response.status === 404) {",
									"        let responseJson = pm.response.json();",
									"        pm.expect(responseJson).to.have.property(\"message\").that.is.a(\"string\");",
									"    }",
