				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const responseData = pm.response.json();",
									"",
									"// Assert that the response contains the token",
									"pm.test(\"Token is present\", function () {",
									"    pm.expect(responseData).to.have.property('token');",
									"    pm.environment.set('token', responseData.token);",
									"});",
									"",
									"// Assert that the response email matches the email environment variable",
									"pm.test(\"Email matches environment variable\", function () {",
									"    pm.expect(responseData.email).to.eql(pm.environment.get(\"email\"));",
									"});",
									"",
									"// Assert that the response username matches the username environment variable",
									"pm.test(\"Username matches environment variable\", function () {",
									"    pm.expect(responseData.username).to.eql(pm.environment.get(\"username\"));",
									"});",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate a unique identifier for the email",
									"const randomString = Math.random().toString(36).substring(2, 8); // Random 6-character string",
									"const uniqueEmail = `test_${randomString}@email.com`;",
									"",
									"// Generate a random username",
									"const uniqueUsername = `TestUser_${randomString}`;",
									"",
									"// Generate a random password",
									"const uniquePassword = `TestPass_${Math.floor(1000 + Math.random() * 9000)}!`;",
									"",
									"// Set these values dynamically in environment variables",
									"pm.environment.set(\"email\", uniqueEmail);",
									"pm.environment.set(\"username\", uniqueUsername);",
									"pm.environment.set(\"password\", uniquePassword);",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{email}}\",\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}\n"
						},
						"url": {
							"raw": "{{baseUrl}}/Auth/Register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"Auth",
								"Register"
							]
						}
					},
					"response": []
				},
