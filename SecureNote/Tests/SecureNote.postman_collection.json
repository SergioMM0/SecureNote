				{
					"name": "Update Note",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Check for successful response",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Validate the response structure",
									"pm.test(\"Response contains updated note\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property(\"id\");",
									"    pm.expect(jsonData).to.have.property(\"title\");",
									"    pm.expect(jsonData).to.have.property(\"content\");",
									"    pm.expect(jsonData).to.have.property(\"nsfw\");",
									"",
									"    // Ensure returned fields match the request",
									"    pm.expect(jsonData.id).to.equal(pm.environment.get(\"noteId\"));",
									"    pm.expect(jsonData.title).to.equal(\"Updated Note Title\");",
									"    pm.expect(jsonData.content).to.equal(\"This is an updated note content.\");",
									"    pm.expect(jsonData.nsfw).to.equal(false);",
									"});",
									"",
									"// Handle unexpected errors",
									"pm.test(\"No unexpected errors\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).not.to.have.property(\"error\");",
									"});",
									""
